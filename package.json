{
  "name": "webluxe-foods",
  "version": "2.0.0",
  "description": "WebLuxe Foods — Mauritian street kitchen. Static Q-Skip takeaway ordering site (SCSS + canvas, no backend).",
  "private": true,
  "scripts": {
    "build": "sass scss/main.scss css/main.css --style=compressed --no-source-map",
    "watch": "sass scss/main.scss css/main.css --watch --no-source-map",
    "start": "npx --yes serve -l 5173 ."
  },
  "devDependencies": {
    "qrcode-generator": "^1.4.4",
    "sass": "^1.80.0"
  }
}
